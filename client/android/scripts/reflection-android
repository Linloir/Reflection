#!/usr/bin/env python3
"""ADB control surface for Reflection; tokens are never printed by this helper."""
import argparse
import pathlib
import re
import shlex
import subprocess
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--serial', help='ADB device serial when several devices are attached')
parser.add_argument('--package', default='io.github.linloir.reflection', help='Installed application ID (for a side-by-side preview build)')
sub = parser.add_subparsers(dest='command', required=True)
install = sub.add_parser('install')
install.add_argument('--apk', type=pathlib.Path, default=pathlib.Path(__file__).resolve().parents[1] / 'build/sdk/reflection-debug.apk')
sub.add_parser('open')
for command in ('connect', 'disconnect', 'status', 'devices', 'paired', 'clear', 'selftest', 'grant-bluetooth'):
    sub.add_parser(command)
configure = sub.add_parser('configure')
configure.add_argument('--host')
configure.add_argument('--port', type=int)
configure.add_argument('--token-file', type=pathlib.Path, help='File containing the 64-character host pairing token')
configure.add_argument('--mode', choices=['tcp', 'bluetooth'])
configure.add_argument('--bluetooth', help='Address of the paired host, e.g. AA:BB:CC:DD:EE:FF')
preview = sub.add_parser('preview')
preview.add_argument('state', choices=['on', 'off'])
stabilization = sub.add_parser('stabilization', help='Configure adaptive pen stabilization')
stabilization.add_argument('state', choices=['on', 'off', 'status'], nargs='?', default='status')
calibration = sub.add_parser('calibration', help='Manage the stationary pen noise calibration')
calibration.add_argument('action', choices=['start', 'finish', 'cancel', 'reset'])
tilt = sub.add_parser('tilt', help='Configure tilt capture and compatible device recovery')
tilt.add_argument('mode', choices=['auto', 'standard', 'off', 'status', 'reset'], nargs='?', default='status')
mapping = sub.add_parser('mapping', help='Inspect or switch the connected host screen mapping')
mapping.add_argument('action', choices=['status', 'query', 'next', 'previous', 'all', 'select'], nargs='?', default='status')
mapping.add_argument('display', nargs='?', help='Host display ID, only for select')
args = parser.parse_args()
if not re.fullmatch(r'[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z][A-Za-z0-9_]*)+', args.package):
    parser.error('Invalid application ID')
if args.command == 'mapping' and ((args.action == 'select') != (args.display is not None)):
    parser.error('mapping select requires a display ID; other actions do not accept one')
adb = ['adb'] + (['-s', args.serial] if args.serial else [])
package = args.package
if args.command == 'install':
    command = adb + ['install', '-r', str(args.apk)]
elif args.command == 'open':
    command = adb + ['shell', 'am', 'start', '-n', package + '/io.github.linloir.reflection.ui.MainActivity']
elif args.command == 'grant-bluetooth':
    command = adb + ['shell', 'pm', 'grant', package, 'android.permission.BLUETOOTH_CONNECT']
else:
    action = 'calibration-' + args.action if args.command == 'calibration' else args.command
    if args.command == 'tilt' and args.mode == 'reset':
        action = 'tilt-reset'
    command = adb + ['shell', 'am', 'broadcast', '-n', package + '/io.github.linloir.reflection.control.ControlReceiver', '--es', 'command', action]
    if args.command == 'configure':
        for key in ('host', 'mode', 'bluetooth'):
            value = getattr(args, key)
            if value is not None:
                if not re.fullmatch(r'[a-zA-Z0-9.:%_\-\[\]]+', value):
                    parser.error('Invalid characters in ' + key)
                command += ['--es', key, value.upper() if key == 'bluetooth' else value]
        if args.port is not None:
            if not 1 <= args.port <= 65535:
                parser.error('Port must be 1..65535')
            command += ['--ei', 'port', str(args.port)]
        if args.token_file:
            token = args.token_file.read_text().strip()
            if not re.fullmatch(r'[0-9a-fA-F]{64}', token):
                parser.error('Token file must contain exactly 64 hexadecimal characters')
            command += ['--es', 'token', token]
    elif args.command == 'preview':
        command += ['--ez', 'enabled', str(args.state == 'on').lower()]
    elif args.command == 'stabilization' and args.state != 'status':
        command += ['--ez', 'enabled', str(args.state == 'on').lower()]
    elif args.command == 'tilt' and args.mode not in ('status', 'reset'):
        command += ['--es', 'mode', args.mode]
    elif args.command == 'mapping':
        command += ['--es', 'action', args.action]
        if args.display is not None:
            command += ['--es', 'display', args.display]
        # GDI display names contain backslashes; preserve them through Android's shell.
        command = adb + ['shell', ' '.join(shlex.quote(value) for value in command[len(adb) + 1:])]
result = subprocess.run(command, capture_output=True, text=True)
# `am broadcast` echoes extras on some Android releases: scrub the token defensively.
output = result.stdout + result.stderr
if args.command == 'configure' and args.token_file:
    output = output.replace(token, '[redacted]')
sys.stdout.write(output)
if result.returncode or re.search(r'Broadcast completed: result=(?!0\b)-?\d+', output):
    raise SystemExit(result.returncode or 1)
