[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%
DriverVer=10/26/2026,0.1.0.0
CatalogFile=ReflectionTablet.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Reflection,NTamd64.10.0...17763,NTarm64.10.0...17763

[Reflection.NTamd64.10.0...17763]
%Device%=Tablet,ROOT\ReflectionTablet
[Reflection.NTarm64.10.0...17763]
%Device%=Tablet,ROOT\ReflectionTablet

[DestinationDirs]
DriverCopy=13
[SourceDisksNames]
1=%Disk%,,,
[SourceDisksFiles]
ReflectionTablet.sys=1

[Tablet.NT]
CopyFiles=DriverCopy
[DriverCopy]
ReflectionTablet.sys
[Tablet.NT.HW]
AddReg=VhfFilter
[VhfFilter]
HKR,,"LowerFilters",0x00010000,"vhf"
[Tablet.NT.Services]
AddService=ReflectionTablet,0x00000002,TabletService
[TabletService]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\ReflectionTablet.sys
[Tablet.NT.Wdf]
KmdfService=ReflectionTablet,TabletWdf
[TabletWdf]
KmdfLibraryVersion=1.27

[Strings]
Provider="Reflection"
Device="Reflection Virtual Tablet"
Disk="Reflection Tablet Driver"
